+            (ihevce_decomp_pre_intra_master_ctxt_t *)
+                ps_enc_ctxt->s_module_ctxt.pv_decomp_pre_intra_ctxt;
+        ihevce_decomp_pre_intra_ctxt_t *ps_ctxt = ps_master_ctxt->aps_decomp_pre_intra_thrd_ctxt[0];
