+                    }
+                }
+                else if((en_merge_32x32 & 2) && (!(en_merge_execution & 2)))
+                {
+#if ENABLE_CU_TREE_CULLING
+                    cur_ctb_cu_tree_t *ps_tree =
+                        ps_ctb_cluster_info->ps_cu_tree_root->ps_child_node_tr;
