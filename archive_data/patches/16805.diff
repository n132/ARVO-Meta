+            ps_hle_ctxt->ps_static_cfg_prms->s_sys_api.pv_cb_handle,
+            "IHEVCE ERROR>> Unable to close OSAL\n");
+        return (-1);
+    }
+
+    /* free osal handle */
+    s_mem_tab.pv_base = pv_osal_handle;
+
+    ps_hle_ctxt->ihevce_mem_free(ps_hle_ctxt->pv_mem_mgr_hdl, &s_mem_tab);
+
+    return (0);
+}
