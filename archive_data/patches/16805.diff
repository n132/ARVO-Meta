+    /* memcpy(pi1_frame_index_initial, pi1_frame_index, MAX_FRAMES_MODELLED); */
+    {
+        UWORD8 u1_k;
+        for(u1_k = 0; u1_k < MAX_FRAMES_MODELLED; u1_k++)
