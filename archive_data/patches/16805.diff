+            ps_ctb += num_ctb_in_frm;
+            ps_cu += num_ctb_in_frm * num_cu_in_ctb;
+            ps_pu += num_ctb_in_frm * num_pu_in_ctb;
+            ps_tu += num_ctb_in_frm * num_tu_in_ctb;
+
+            pu1_coeffs += coeff_size;
