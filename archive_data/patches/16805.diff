+******************************************************************************
+ */
+typedef struct
+{
+    /** Start of partition w.r.t. CU start in x dirn */
+    U08 u1_x_start;
+    /** Size of partitino w.r.t. CU start in x dirn */
+    U08 u1_x_count;
+    /** Start of partition w.r.t. CU start in y dirn */
+    U08 u1_y_start;
+    /** Size of partitino w.r.t. CU start in y dirn */
