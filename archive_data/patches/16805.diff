+            pu1_mv_bank += mv_bank_size;
+            pu1_ref_idx_bank += ref_idx_bank_size;
+            plf_intra_8x8_cost +=
+                (((num_ctb_horz * ctb_size) >> 3) * ((num_ctb_vert * ctb_size) >> 3));
