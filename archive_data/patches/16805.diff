+    LWORD64 i8_first_pic_bits_pictype[MAX_PIC_TYPE];
+    LWORD64 i8_avg_bits_pictype[MAX_PIC_TYPE];
+    WORD32 i4_avg_qscale_gop_first_pass;
+    WORD32 i4_fp_bit_alloc_in_sp;
