+    pv_me_ctxt->s_func_selector.pf_had_16x16_r = &ihevce_had_16x16_r;
+    pv_me_ctxt->s_func_selector.pf_compute_32x32HAD_using_16x16 = &ihevce_compute_32x32HAD_using_16x16;
