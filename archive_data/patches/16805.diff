+void ihevce_coarse_me_process(
+    void *pv_me_ctxt,
+    ihevce_lap_enc_buf_t *ps_enc_lap_inp,
+    multi_thrd_ctxt_t *ps_multi_thrd_ctxt,
+    WORD32 thrd_id,
