+******************************************************************************
+ */
+#define CHECK_MV_WITHIN_RANGE(x, y, range)                                                         \
+    (((x) > (range)->i2_min_x) && ((x) < (range)->i2_max_x) && ((y) > (range)->i2_min_y) &&        \
+     ((y) < (range)->i2_max_y))
+
+#define CONVERT_MV_LIMIT_TO_QPEL(range)                                                            \
+    {                                                                                              \
+        (range)->i2_max_x <<= 2;                                                                   \
+        (range)->i2_max_y <<= 2;                                                                   \
+        (range)->i2_min_x <<= 2;                                                                   \
+        (range)->i2_min_y <<= 2;                                                                   \
+    }
+
+#define CONVERT_MV_LIMIT_TO_FPEL(range)                                                            \
+    {                                                                                              \
+        (range)->i2_max_x >>= 2;                                                                   \
+        (range)->i2_max_y >>= 2;                                                                   \
+        (range)->i2_min_x >>= 2;                                                                   \
+        (range)->i2_min_y >>= 2;                                                                   \
+    }
