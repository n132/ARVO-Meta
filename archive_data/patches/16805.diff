+
+typedef LOOPIDX LOOPINDEX; /* lp    LOOPIDX  lp_index       */
+typedef ULOOPIDX ULOOPINDEX; /* ulp   SLOOPIDX ulp_index      */
+
+#define PLATFORM_INLINE __inline
+
+#endif /* __TYPEDEFTEST_H__ */
