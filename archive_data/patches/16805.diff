+                last_ctb_row_flag,
+                (ctb_ctr == (num_ctbs_horz_pic - 1)),
+                last_hz_ctb_wd,
+                last_vt_ctb_ht);
+
+            /* -----------------Read boundary strengts for current CTB------------- */
+
+            if((0 == ps_ctxt->i4_deblock_type) && (ps_ctxt->i4_deblk_pad_hpel_cur_pic))
+            {
