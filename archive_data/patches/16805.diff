+    WORD32 i4_blocking_mode,
+    WORD32 i4_bitrate_instance,
+    WORD32 i4_res_instance)
+{
+    void *pv_ptr;
+
+    pv_ptr = ihevce_q_get_free_buff(
+        ps_hle_ctxt->apv_enc_hdl[i4_res_instance],
+        (IHEVCE_RECON_DATA_Q + i4_bitrate_instance),
+        pi4_buff_id,
+        i4_blocking_mode);
+    return (pv_ptr);
+}
