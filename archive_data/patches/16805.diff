+#ifndef _PIC_HANDLING_H_
+#define _PIC_HANDLING_H_
+
+/* Basic Understanding:
+ * add_pic_to_stack(_re_enc):
+ *  This functions converts the input (or display) order to encoding order
+ *
+ * */
+/*****************************************************************************/
+/* Structure                                                                 */
+/*****************************************************************************/
