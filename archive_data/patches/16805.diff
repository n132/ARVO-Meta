+
+    /** Coding parameters for the encoder */
+    ihevce_coding_params_t s_coding_tools_prms;
+
+    /** Configurable parameters for Encoder */
+    ihevce_config_prms_t s_config_prms;
+
+    /** VUI SEI app parameters*/
