+
+#if PROFILE_ENC_REG_DATA
+    s_profile.u8_enc_reg_data[vert_ctr] = 0;
+#endif
+
+    /* -- Loop over all the CTBs in a row for Deblocking and Subpel gen --- */
+    if(!ps_ctxt->u1_is_input_data_hbd)
+    {
