+
+    /**
+     *  List of 2Nx2N PU candidates in CU
+     * +1 to signal the last flag invalid value of 255 needs to be stored
+     */
+    UWORD8 au1_intra_luma_modes_2nx2n_tu_eq_cu_by_2[MAX_INTRA_CU_CANDIDATES + 1];
+
