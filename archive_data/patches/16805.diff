+void hme_update_results_grid_pu_bestn(result_upd_prms_t *ps_result_prms)
+{
+    search_node_t s_search_node_grid;
+    const search_node_t *ps_search_node_base;
+    search_node_t *ps_search_node_grid, *ps_best_node;
