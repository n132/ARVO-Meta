+#define MIN(x, y) ((x) < (y)) ? (x) : (y)
+#define MAX(x, y) ((x) < (y)) ? (y) : (x)
+
+/* State structure for bit allocation */
+typedef struct
+{
+    WORD32 i4_rem_bits_in_period;
+    /* Storing inputs */
+    WORD32 i4_tot_frms_in_gop;
+    WORD32 i4_num_intra_frm_interval;
