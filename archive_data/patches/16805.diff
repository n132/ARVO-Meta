     max_tile_rows = (ht + MIN_TILE_HT - 1) / MIN_TILE_HT;
     max_ctb_rows  = ht / MIN_CTB_SIZE;
     max_ctb_cols  = wd / MIN_CTB_SIZE;
     max_ctb_cnt   = max_ctb_rows * max_ctb_cols;
     max_num_cu_cols = wd / MIN_CU_SIZE;
     max_num_cu_rows = ht / MIN_CU_SIZE;
