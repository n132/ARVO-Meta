     */
     UWORD8 u1_log2_max_mv_length_vertical;
 
     /**
      * HRD parameters
      */
 
 
     /**
     *   Indicates the presence of the
     *   num_units_in_ticks, time_scale flag
     */
     UWORD8 u1_timing_info_present_flag;
 
     /**
