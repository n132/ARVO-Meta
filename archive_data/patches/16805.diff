+                    c = pu1_luma_recon_buf[col];
+                    a = pu1_luma_recon_buf[col + 1 - i4_luma_recon_strd];
+                    b = pu1_luma_recon_buf[col - 1 + i4_luma_recon_strd];
+                    pel_err = pu1_luma_src_buf[col] - pu1_luma_recon_buf[col];
+                    edge_idx = 2 + SIGN(c - a) + SIGN(c - b);
+                    if(pel_err != 0)
+                    {
