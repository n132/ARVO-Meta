+                ps_enc_out_ctxt++;
+
+                ASSERT(ps_ctb_in->u1_num_cus_in_ctb <= MAX_CTB_SIZE);
+
+            } while(ps_enc_out_ctxt->u1_cu_size != 128);
+        }
+#endif
+
+        /* --- ctb level copy of data to left buffers--*/
