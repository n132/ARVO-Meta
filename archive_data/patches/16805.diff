+
+                    ps_sao_ctxt->pu1_cur_chroma_recon_buf =
+                        ps_sao_ctxt->pu1_frm_chroma_recon_buf +
+                        (ps_sao_ctxt->i4_frm_chroma_recon_stride * ps_sao_ctxt->i4_ctb_y *
