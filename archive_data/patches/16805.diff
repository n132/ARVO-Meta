+
+    /** Recon Pic buffer pointers for L0 list */
+    recon_pic_buf_t **pps_rec_list_l1;
+
+    /** Reference descriptors for all ref pics */
+    hme_ref_desc_t as_ref_desc[MAX_NUM_REF];
+
+} hme_ref_map_t;
