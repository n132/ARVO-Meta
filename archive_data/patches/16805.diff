+ * @param[in] dst_strd_chr_flag
+ *  Output Stride and Chroma Flag packed in the MS and LS 16-bit
+ *
+ * @returns  Void
+ *
+ * @remarks
+ *  None
+ *
+ *******************************************************************************
+ */
+
+UWORD32 ihevc_resi_trans_32x32(UWORD8 *pu1_src,
+                            UWORD8 *pu1_pred,
+                            WORD32 *pi4_temp,
+                            WORD16 *pi2_dst,
+                            WORD32 src_strd,
+                            WORD32 pred_strd,
