+#else
+        if(ps_ctxt->i4_quality_preset < IHEVCE_QUALITY_P2)
+        {
+            ihevce_enc_cu_node_ctxt_t *ps_enc_out_ctxt = &ps_ctxt->as_enc_cu_ctxt[0];
