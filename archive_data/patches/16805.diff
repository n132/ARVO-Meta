+        {
+            WORD32 num_sei;
+            pps_frm_proc_ent_cod_bufs[i][ctr] = ps_frmp_ent_bufs;
+
+            ps_frmp_ent_bufs->ps_frm_ctb_data = ps_ctb;
+            ps_frmp_ent_bufs->ps_frm_cu_data = ps_cu;
+            ps_frmp_ent_bufs->ps_frm_pu_data = ps_pu;
+            ps_frmp_ent_bufs->ps_frm_tu_data = ps_tu;
