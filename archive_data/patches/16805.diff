+                            ->aaps_enc_loop_rc_params[ps_ctxt->i4_enc_frm_id]
+                                                     [ps_ctxt->i4_bitrate_instance_num]
+                            ->u4_frame_rdopt_bits += u4_ctb_sao_bits;
