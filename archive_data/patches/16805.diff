+                            rc_getprev_ref_pic_type(ps_rc_ctxt->rc_hdl);
+
+                        if(i4_hevc_frame_qp >
+                           ps_rc_ctxt->ai4_prev_pic_hevc_qp[i4_scene_num][prev_ref_pic_type] + 3)
