+                {
+                    for(col = 0; col < 4; col++)
+                    {
+                        if(pi2_block[row * dst_q_strd + col] != 0)
+                        {
+                            *(csbf + block_col) = 1;
+                            break;
+                        }
+                    }
+                    if(*(csbf + block_col) == 1)
+                    {
