+                }
+
+                if((en_merge_32x32 & 4) && (en_merge_execution & 4))
+                {
+                    range_prms_t *ps_pic_limit;
+                    if(s_merge_prms_32x32_bl.i4_use_rec == 1)
+                    {
+                        ps_pic_limit = &s_pic_limit_rec;
