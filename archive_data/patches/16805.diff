+                [MAX_NUM_INTRA_MODES_PER_TU_DISTRIBUTION_IN_XS25] = 255;
+            ps_cu_intra_cand->au1_intra_luma_modes_2nx2n_tu_eq_cu_by_2
+                [MAX_NUM_INTRA_MODES_PER_TU_DISTRIBUTION_IN_XS25] = 255;
