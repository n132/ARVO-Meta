+void hme_init_wkg_mem(buf_mgr_t *ps_buf_mgr, U08 *pu1_mem, S32 size)
+{
+    ps_buf_mgr->pu1_wkg_mem = pu1_mem;
+    ps_buf_mgr->i4_total = size;
+    hme_reset_wkg_mem(ps_buf_mgr);
+}
