+                    else
+                        cur_hevc_qp = I_hevc_qp + (rc_pic_type - FIELD_OFFSET);
+
+                    i4_prev_qp = ps_rc_ctxt->ai4_prev_pic_hevc_qp[i4_scene_num][rc_pic_type];
+
+                    if((cur_hevc_qp < i4_prev_qp) && (ps_rc_ctxt->i4_num_active_pic_type > 2) &&
