+        ps_func_list->pf_HAD_32x32_8bit = ihevce_HAD_32x32_8bit_neon;
+        ps_func_list->pf_HAD_4x4_8bit = ihevce_HAD_4x4_8bit_neon;
+        ps_func_list->pf_HAD_8x8_8bit = ihevce_HAD_8x8_8bit_neon;
