+            s_deblk_ctb_row_params.pu4_ctb_row_bs_vert +=
+                (ctb_size >> 3);  //one vertical edge per 8x8 block
+            s_deblk_ctb_row_params.pu4_ctb_row_bs_horz +=
+                (ctb_size >> 3);  //one horizontal edge per 8x8 block
