     // Scale vector such that the sum equals the center value.
     int32_t int_vec[3];
     int_vec[0] =
         static_cast<int32_t>(floor(scaled_vector[0] * center_value_ + 0.5));
     int_vec[1] =
         static_cast<int32_t>(floor(scaled_vector[1] * center_value_ + 0.5));
