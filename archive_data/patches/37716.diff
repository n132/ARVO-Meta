     uint32_t num_entries = 0;
     if (!DecodeVarint(&num_entries, buffer_)) {
       return false;
     }
     for (uint32_t i = 0; i < num_entries; ++i) {
       if (!DecodeEntry(metadata)) {
         return false;
       }
     }
     uint32_t num_sub_metadata = 0;
     if (!DecodeVarint(&num_sub_metadata, buffer_)) {
