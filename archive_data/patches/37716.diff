 int main(int argc, char **argv) {
   Options options;
   const int argc_check = argc - 1;
 
   for (int i = 1; i < argc; ++i) {
     if (!strcmp("-h", argv[i]) || !strcmp("-?", argv[i])) {
       Usage();
