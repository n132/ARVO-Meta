           std::unique_ptr<Metadata>(new Metadata());
       metadata = sub_metadata.get();
       if (!mp.parent_metadata->AddSubMetadata(sub_metadata_name,
                                               std::move(sub_metadata))) {
         return false;
       }
     }
     if (metadata == nullptr) {
       return false;
