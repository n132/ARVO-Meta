+      const PointIndex point_from = face[(c + 1) % 3];
+      const PointIndex point_to = face[(c + 2) % 3];
+      polygon_edges->insert(
+          {PositionIndex(pos_att_->mapped_index(point_from)), point_to});
+    }
+  }
+}
