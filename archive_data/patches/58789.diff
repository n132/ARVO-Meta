+    return (PPC_getFeatureBits(Inst->csh->mode, PPC_FeaturePS));
+  case 14:
+    return (PPC_getFeatureBits(Inst->csh->mode, PPC_FeatureQPX));
+  case 15:
+    return (PPC_getFeatureBits(Inst->csh->mode, PPC_FeatureSPE));
